# ─────────────────────────────────────────────────────────────────────────────
# EtherHawk — Standalone EtherHiding Detection Appliance
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dashboard / API authentication ───────────────────────────────────────────
# Shared token required to log in to the dashboard and call the API.
# Generate a strong value, e.g.:  openssl rand -hex 32
# The appliance refuses access while this is unset or left at the placeholder.
ETHERHAWK_DASHBOARD_TOKEN=change-me-openssl-rand-hex-32

# ── Egress ────────────────────────────────────────────────────────────────────
# EtherHiding stage-1 gates only fire for RESIDENTIAL IPs. By default the
# appliance egresses through the Docker host's own public IP (your homelab /
# server residential IP) — leave UPSTREAM_PROXY blank to use it.
# Only set an upstream proxy if you deliberately want to route egress elsewhere
# (e.g. a residential proxy provider). Datacenter/VPN proxies will suppress the
# eth_call and are NOT recommended.
UPSTREAM_PROXY=

# ── Browser / investigation tuning ────────────────────────────────────────────
# Per-page navigation timeout (seconds) and number of escalation attempts.
VISIT_TIMEOUT=40
MAX_ATTEMPTS=2
# Extra dwell time (seconds) after load to let gated/deferred chains fire.
POST_LOAD_DWELL=6

# ── MISP (optional) ───────────────────────────────────────────────────────────
# If both are set, confirmed cases auto-create a defanged TLP:AMBER event.
# Can also be configured from the dashboard Settings tab (stored in SQLite).
MISP_URL=
MISP_API_KEY=
# Verify MISP TLS cert (set to false only for self-signed lab instances).
MISP_VERIFY_TLS=true

# ── Paths / internal service URLs (defaults are correct for docker-compose) ───
WORKSPACE=/workspace
MITM_PROXY=http://etherhawk-proxy:8095
MITM_FLOWS_PATH=/workspace/_mitm/flows.jsonl
BROWSER_URL=http://etherhawk-browser:9001
DEOBFUSCATOR_URL=http://etherhawk-deobf:3020/deobfuscate
SANDBOX_URL=http://etherhawk-sandbox:3021/run

# ── Host port bindings ────────────────────────────────────────────────────────
UI_PORT=8080
API_PORT=8094
MITMWEB_PORT=8081

# ── SSRF guard ────────────────────────────────────────────────────────────────
# Block submissions that resolve to private/loopback/link-local/reserved ranges.
# Set to true ONLY for authorized internal-network testing.
ALLOW_PRIVATE_TARGETS=false

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Do not advertise nginx version.
    server_tokens off;

    # ── Auth gate for the noVNC proxy ────────────────────────────────────────
    # The analyst browser is a live, internet-capable Chrome — it must not be
    # reachable just by hitting port 8080. The dashboard sets an `eh_token` cookie
    # on login; this internal subrequest validates it against the API before nginx
    # proxies /novnc/ or /websockify. 204 = allow, 401 = deny.
    location = /__novnc_auth {
        internal;
        proxy_pass http://etherhawk-api:8000/api/novnc-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        # Cookie is forwarded by default so the API sees eh_token.
    }

    # noVNC analyst browser — proxied so the user never sees the self-signed cert.
    # The kasm Basic-Auth credential is built from KASM_PASSWORD at container start
    # (${KASM_BASIC_AUTH}); it is never hardcoded in source.
    location /novnc/ {
        auth_request /__novnc_auth;
        proxy_pass https://etherhawk-interactive:6901/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host etherhawk-interactive;
        proxy_set_header Authorization "${KASM_BASIC_AUTH}";
        proxy_ssl_verify off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # kasmweb/noVNC WebSocket endpoint. The iframe JS builds its WS URL as
    # <host>:<port>/websockify, so the upgrade arrives here (not /novnc/websockify).
    location /websockify {
        auth_request /__novnc_auth;
        proxy_pass https://etherhawk-interactive:6901/websockify;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host etherhawk-interactive;
        proxy_set_header Authorization "${KASM_BASIC_AUTH}";
        proxy_ssl_verify off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # SPA assets
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin API proxy (so the browser never needs CORS and the token
    # stays on one origin). SSE needs buffering off + long read timeout.
    location /api/ {
        proxy_pass http://etherhawk-api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1800s;
        client_max_body_size 32m;
    }
}
